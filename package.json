{
  "name": "@icrc/openmrs-esm-icrc",
  "packageManager": "yarn@4.10.3",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "openmrs develop",
    "ci:publish": "lerna publish from-package --yes",
    "ci:prepublish": "lerna publish from-package --no-git-reset --yes --dist-tag next",
    "release": "lerna version --no-git-tag-version",
    "verify": "turbo run lint && turbo run typescript",
    "prettier": "prettier --config prettier.config.js --write \"packages/**/*.{ts,tsx}\"",
    "prepare": "husky install",
    "test": "cross-env TZ=UTC jest --config jest.config.js --verbose false --passWithNoTests --ci --reporters=default --reporters=jest-junit",
    "test-watch": "cross-env TZ=UTC jest --watch --config jest.config.js",
    "coverage": "yarn test --coverage"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/icrc/openmrs-esm-icrc.git"
  },
  "homepage": "https://github.com/icrc/openmrs-esm-icrc",
  "bugs": {
    "url": "https://github.com/icrc/openmrs-esm-icrc/issues"
  },
  "devDependencies": {
    "@jsenv/file-size-impact": "12.1.10",
    "@openmrs/esm-framework": "next",
    "@openmrs/esm-patient-common-lib": "next",
    "@openmrs/esm-patient-forms-app": "next",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.1",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.11",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "concurrently": "^6.5.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.0.3",
    "d3-selection": "^3.0.0",
    "dayjs": "^1.8.36",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-ts-react-important-stuff": "^3.0.0",
    "eslint-plugin-playwright": "^2.3.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.3",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-environment-jsdom": "^30.1.1",
    "jest-junit": "^15.0.0",
    "lerna": "^7.3.0",
    "lodash": "^4.17.21",
    "openmrs": "next",
    "prettier": "^3.1.1",
    "pretty-quick": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^11.18.6",
    "react-router-dom": "^6.16.0",
    "rxjs": "^7.8.0",
    "sass": "^1.54.3",
    "swc-loader": "^0.2.3",
    "swr": "^2.2.5",
    "systemjs-webpack-interop": "^2.3.7",
    "turbo": "^2.5.2",
    "typescript": "^5.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix"
  },
  "resolutions": {
    "sass": "^1.54.3",
    "extend": "^3.0.0",
    "axios": "^1.11.0",
    "path-to-regexp": "^6.3.0",
    "semver": "^7.7.3",
    "glob": "^9.3.5",
    "webpack-dev-server": "^5.2.2",
    "rxjs": "6.x",
    "@types/lodash-es": "^4.17.12",
    "@openmrs/esm-api/lodash-es": "4.17.23",
    "@openmrs/esm-patient-common-lib/lodash-es": "4.17.23",
    "openmrs/lodash-es": "4.17.23",
    "lodash-es": "4.17.23"
  },
  "dependencies": {
    "@openmrs/webpack-config": "next"
  }
}
