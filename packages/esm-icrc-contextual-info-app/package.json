{
  "name": "@icrc/esm-icrc-contextual-info-app",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "description": "Contextual information microfrontend for the OpenMRS SPA",
  "browser": "dist/esm-icrc-contextual-info-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "webpack serve --mode=development",
    "debug": "npm run serve",
    "build": "webpack --mode production",
    "analyze": "webpack --mode=production --env analyze=true",
    "lint": "eslint src --ext tsx,ts",
    "typescript": "tsc",
    "extract-translations": "i18next 'src/**/*.component.tsx' --config ../../tools/i18next-parser.config.js"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icrc/openmrs-esm-icrc.git",
    "directory": "packages/esm-icrc-contextual-info-app"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/react": "^1.83.0"
  },
  "devDependencies": {
    "single-spa": "6.x",
    "single-spa-react": "^6.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.2"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "8.x",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "11.x",
    "react-router-dom": "6.x",
    "rxjs": "7.x"
  }
}
