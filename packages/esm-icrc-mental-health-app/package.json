{
  "name": "@icrc/esm-patient-mental-health-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Mental Health microfrontend for the OpenMRS SPA",
  "browser": "dist/openmrs-esm-patient-mental-health-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "webpack serve --mode=development",
    "debug": "npm run serve",
    "build": "webpack --mode production",
    "analyze": "webpack --mode=production --env analyze=true",
    "lint": "eslint src --ext tsx,ts",
    "typescript": "tsc",
    "extract-translations": "i18next 'src/**/*.component.tsx' --config ../../tools/i18next-parser.config.js"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs"
  ],
  "dependencies": {
    "@carbon/charts-react": "^1.5.2",
    "@carbon/react": "^1.83.0",
    "@openmrs/esm-framework": "next",
    "@openmrs/esm-patient-common-lib": "next",
    "d3": "^7.6.1",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "webpack": "^5.99.9"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "8.x",
    "@openmrs/esm-patient-common-lib": "11.x",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "11.x",
    "react-router-dom": "6.x",
    "rxjs": "7.x"
  }
}
